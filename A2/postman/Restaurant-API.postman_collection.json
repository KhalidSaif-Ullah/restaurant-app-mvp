
{
  "info": {
    "name": "Restaurant API",
    "description": "A2 API verification: health, authentication, menu CRUD, orders, reservations, tables, authorization and error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Health status is ok and time exists', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('ok'); pm.expect(b.time).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - MongoDB connection check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/test-db"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Database connection check returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Unknown route returns 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/route-that-does-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown route returns 404', () => pm.response.to.have.status(404));",
              "pm.test('Unknown route message is Route not found', () => pm.expect(pm.response.json().message).to.eql('Route not found'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Register customer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('customerEmail')) pm.collectionVariables.set('customerEmail', 'a2_customer_' + Date.now() + '@example.com');",
              "pm.collectionVariables.set('customerPassword', 'Customer123!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer registration returns 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"A2 Test Customer\",\"email\":\"{{customerEmail}}\",\"password\":\"{{customerPassword}}\",\"role\":\"Customer\"}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "05 - Login customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{customerEmail}}\",\"password\":\"{{customerPassword}}\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer login returns 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "if (b.token) pm.collectionVariables.set('customerToken', b.token);",
              "pm.test('Customer token received', () => pm.expect(b.token).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
