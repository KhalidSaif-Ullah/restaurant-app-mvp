    {
      "name": "13 - Create order as customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"items\":[{\"menuItem\":\"{{menuItemId}}\",\"quantity\":2}],\"deliveryAddress\":\"A2 API test address\"}"
        },
        "url": "{{baseUrl}}/api/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created with 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "if (b.order && b.order._id) pm.collectionVariables.set('orderId', b.order._id);",
              "pm.test('Order total is calculated', () => pm.expect(b.order.totalAmount).to.eql(26));"
            ]
          }
        }
      ]
    },
